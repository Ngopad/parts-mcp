# Kopiér til .env og udfyld. .env må ALDRIG i git.

# DigiKey (developer.digikey.com -> din organisation -> app med Product Information v4)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Til test: https://sandbox-api.digikey.com
DIGIKEY_BASE_URL=https://api.digikey.com
DIGIKEY_SITE=DK
DIGIKEY_LANGUAGE=en
DIGIKEY_CURRENCY=DKK
CACHE_SECONDS=3600

# Login for teamet (GitHub -> Settings -> Developer settings -> OAuth Apps)
# Lad GITHUB_CLIENT_ID stå tom for at køre uden login (kun lokalt!)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_URL=https://thinkcentre.DIT-TAILNET.ts.net
# Kommasepareret liste af GitHub-brugernavne
ALLOWED_GITHUB_USERS=
