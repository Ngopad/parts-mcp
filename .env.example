# Kopiér til .env og udfyld. .env må ALDRIG i git.

# DigiKey (developer.digikey.com -> din organisation -> app med Product Information v4)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Til test: https://sandbox-api.digikey.com
DIGIKEY_BASE_URL=https://api.digikey.com
DIGIKEY_SITE=DK
DIGIKEY_LANGUAGE=en
DIGIKEY_CURRENCY=DKK
CACHE_SECONDS=3600

# KiCad MCP Pro: tilfældig streng på mindst 32 tegn
KICAD_MCP_AUTH_TOKEN=
# Mappe med KiCad-projekter (standard: ./projects i repoet).
# Windows med Docker i WSL: brug WSL-sti, f.eks. /mnt/c/Users/<dig>/Documents/KiCad
KICAD_PROJECTS=./projects

# Leverandører uden nøgle bliver bare ikke slået til.
# jlcsearch (JLCPCB/LCSC-katalog) kræver ingen nøgle og er altid slået til.
MOUSER_API_KEY=
FARNELL_API_KEY=
FARNELL_STORE=dk.farnell.com
# Farnells API oplyser ikke valuta - sæt den til butikkens valuta
FARNELL_CURRENCY=DKK
